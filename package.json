{
  "name": "full-stack-boilerplate",
  "version": "0.3.0",
  "description": "Full Stack Boilerplate",
  "repository": "https://github.com/dev-academy-challenges/full-stack-boilerplate.git",
  "main": "server/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "run-p watch:client watch:server",
    "watch:client": "webpack --watch",
    "watch:server": "nodemon --watch server",
    "start": "node server",
    "test": "jest --noStackTrace --watchAll",
    "test:ci": "jest --noStackTrace --watchAll=false",
    "knex": "knex --knexfile server/db/knexfile.js",
    "build": "webpack --mode production"
  },
  "author": "EDA",
  "license": "ISC",
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ],
    "plugins": [
      "@babel/plugin-proposal-class-properties",
      "@babel/plugin-proposal-object-rest-spread"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "./tests/setup-textencoder.js",
      "./tests/setup-dotenv.js",
      "./tests/client/setup-enzyme.js"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "<rootDir>/tests/client/styleMock.js"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "babel-jest": "^30.3.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "nodemon": "^3.1.9",
    "sass": "^1.83.0",
    "sqlite3": "^6.0.1",
    "supertest": "^7.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.2",
    "bulma": "^0.9.4",
    "css-loader": "^7.1.2",
    "dotenv": "^16.4.5",
    "dotenv-webpack": "^8.1.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "knex": "^3.1.0",
    "mini-css-extract-plugin": "^2.9.2",
    "multer": "^1.4.5-lts.2",
    "npm-run-all": "^4.1.5",
    "pg": "^8.13.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-map-gl": "^5.2.8",
    "react-redux": "^7.2.9",
    "react-router-dom": "^5.3.4",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "sass-loader": "^16.0.3",
    "superagent": "^10.1.1",
    "supercluster": "^7.1.0",
    "use-supercluster": "^0.2.9"
  }
}

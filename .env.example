JWT_SECRET="I Hate the Turtles! - Krang"
# Optional; default is 1d (jsonwebtoken expiresIn). Examples: 8h, 7d
# JWT_EXPIRE_TIME="1d"

# Production / Vercel (PostgreSQL via Neon + standard node-postgres `pg`)
# CLI migrations: use Neon’s direct connection URL (no `-pooler` in host). Pooler URLs can fail migrations.
# Running app on Vercel: pooled URL (`-pooler` host) is fine for many workloads.
# Optional on URL: sslmode=verify-full (knexfile also upgrades require→verify-full to silence pg v8 warnings).
# DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full"
# Optional: cap Knex pool size per server instance (default 10)
# DB_POOL_MAX=5
# DATABASE_SSL defaults to on; set DATABASE_SSL=false for local Postgres without SSL

# Profile image uploads on Vercel (Blob store)
# BLOB_READ_WRITE_TOKEN=""
